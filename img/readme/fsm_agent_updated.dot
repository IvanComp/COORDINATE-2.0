digraph AgentFSM {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.35",
    nodesep="0.72",
    ranksep="0.75",
    splines=ortho,
    outputorder=edgesfirst
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=2,
    fontname="Helvetica-Bold",
    fontsize=18,
    margin="0.18,0.12",
    width=1.75,
    height=0.7
  ];

  edge [
    fontname="Helvetica",
    fontsize=12,
    color="#374151",
    penwidth=2,
    arrowsize=0.8
  ];

  start [label="", shape=circle, width=0.22, height=0.22, fillcolor="#111827", color="#111827", fixedsize=true];
  idle [label="Idle", fillcolor="#E0F2FE", color="#0284C7", fontcolor="#0C4A6E"];
  carrying [label="Carrying", fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F"];
  rescuing [label="Rescuing", fillcolor="#F3E8FF", color="#9333EA", fontcolor="#581C87"];
  returning [label="Returning", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A"];
  failed [label="Failed", fillcolor="#FEE2E2", color="#DC2626", fontcolor="#7F1D1D"];

  start -> idle;

  idle -> carrying [label="startLoading"];
  idle -> rescuing [label="rescue", color="#9333EA", fontcolor="#581C87"];
  idle -> failed [label="fail", color="#DC2626", fontcolor="#7F1D1D"];

  carrying -> carrying [label="move"];
  carrying -> idle [label="deliver", color="#16A34A", fontcolor="#14532D"];
  carrying -> returning [label="drop", color="#D97706", fontcolor="#78350F"];
  carrying -> rescuing [label="rescue", color="#9333EA", fontcolor="#581C87"];
  carrying -> failed [label="fail", color="#DC2626", fontcolor="#7F1D1D"];

  rescuing -> rescuing [label="move"];
  rescuing -> carrying [label="startLoading"];
  rescuing -> returning [label="move [no task]", color="#2563EB", fontcolor="#1E3A8A"];
  rescuing -> failed [label="fail", color="#DC2626", fontcolor="#7F1D1D"];

  returning -> returning [label="move"];
  returning -> carrying [label="startLoading"];
  returning -> idle [label="move [at source]", color="#2563EB", fontcolor="#1E3A8A"];
  returning -> failed [label="fail", color="#DC2626", fontcolor="#7F1D1D"];

  failed -> idle [label="recover", color="#16A34A", fontcolor="#14532D"];

  idle -> idle [label="fakeFailure", style=dashed, color="#7C3AED", fontcolor="#5B21B6"];
  carrying -> carrying [label="fakeFailure", style=dashed, color="#7C3AED", fontcolor="#5B21B6"];
  rescuing -> rescuing [label="fakeFailure", style=dashed, color="#7C3AED", fontcolor="#5B21B6"];
  returning -> returning [label="fakeFailure", style=dashed, color="#7C3AED", fontcolor="#5B21B6"];

  note [
    label="Labels are CSV events. Conditions are in brackets.\\nfakeFailure is logged but does not change state.",
    shape=note,
    fillcolor="#F9FAFB",
    color="#9CA3AF",
    fontname="Helvetica",
    fontsize=12,
    fontcolor="#374151",
    width=4.2,
    height=0.75
  ];
  note -> failed [style=invis];
}
