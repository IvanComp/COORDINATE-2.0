// time,itemId,event,destination
input time: Float
input itemId: Int
input event: String
input destination: Int

// Helper streams to simplify event checking
output created: Bool   := event == "create"
output delivered: Bool := event == "deliver"
output expired: Bool   := event == "expire"

// Task-outcome evidence for the completion-constrained performance objective.
// Completion is formed from delivered and expired task outcomes over the same
// rolling horizon; pending tasks are kept as context rather than successes.
output monitor_created_task_event: Float
    eval when created with 1.0
output monitor_delivered_task_event: Float
    eval when delivered with 1.0
output monitor_expired_task_event: Float
    eval when expired with 1.0

// Runtime evidence used by Dynamic Adaptation.  These streams are derived
// exclusively from events observed by the monitor; no simulation parameter is
// exposed to the adaptation policy.
output monitor_message_event: Float
    eval when event == "message_delivered" or event == "message_lost" with 1.0
output monitor_message_loss_event: Float
    eval when event == "message_lost" with 1.0
output monitor_network_probe_event: Float
    eval when event == "network_probe_delivered" or event == "network_probe_lost" with 1.0
output monitor_network_probe_loss_event: Float
    eval when event == "network_probe_lost" with 1.0
output monitor_failure_event: Float
    eval when event == "agent_failed" with 1.0
output monitor_rescue_request_event: Float
    eval when event == "rescue_request" with 1.0
output monitor_fake_evidence_event: Float
    eval when event == "verified_fake_request" with 1.0
output monitor_suspicious_signal_event: Float
    eval when event == "suspicious_signal" with 1.0
output monitor_coordinator_outage_event: Float
    eval when event == "coordinator_unavailable" with 1.0

// --- Create Event Stream ---

output create_item(id):Float
    // Spawn a new instance whenever a 'created' event occurs
    spawn with itemId
    // This instance stores the creation time of the matching item only.
    eval when id = itemId and created with time

// --- Deliver Event Stream ---

output deliver_item(id)
    // Spawn a new instance when an item is delivered.
    // We only care about the *same* item ID that was used to spawn create_item(id).
    // The key is that the 'spawn' clause here uses the itemID, and the 'eval when'
    // condition filters for when that specific item is delivered.
    spawn with itemId
    eval when id = itemId and delivered with time
    // We can also simplify this by defining a stream that only contains
    // delivery events for the *current* spawned ID.
    
// --- Latency Stream ---

// This stream measures the time difference between the creation and delivery of a specific item ID.
output latency(id)
    // Spawn an instance whenever an item is created.
    // The spawned instance will track *this* item's lifecycle.
    spawn with itemId
    
    // The `eval when` clause is triggered when a 'delivered' event occurs *for this item ID*.
    // The value is the current time minus the creation time (which is the value of create_item(id)).
    eval when id = itemId and delivered with time - create_item(id).hold(or: 0.0) 
    
    // Close the instance once the delivery latency is calculated
    close when id = itemId and (delivered or expired)

// Minimum expected delivery time from the source room to each destination in
// the GUH73 scenario: loading + shortest-path movement + drop.
output min_delivery_time: Float :=
if destination == 1 then 7.0
else if destination == 2 then 12.0
else if destination == 3 then 17.0
else if destination == 4 then 22.0
else if destination == 5 then 27.0
else if destination == 6 then 32.0
else if destination == 7 then 37.0
else if destination == 8 then 42.0
else if destination == 9 then 47.0
else if destination == 10 then 52.0
else if destination == 11 then 57.0
else if destination == 12 then 62.0
else if destination == 13 then 67.0
else if destination == 14 then 72.0
else if destination == 15 then 77.0
else if destination == 16 then 82.0
else if destination == 17 then 87.0
else if destination == 18 then 47.0
else if destination == 19 then 47.0
else if destination == 20 then 52.0
else if destination == 21 then 57.0
else if destination == 22 then 62.0
else if destination == 23 then 7.0
else if destination == 24 then 12.0
else if destination == 25 then 17.0
else if destination == 26 then 22.0
else if destination == 27 then 27.0
else if destination == 28 then 32.0
else if destination == 29 then 37.0
else if destination == 30 then 42.0
else if destination == 31 then 47.0
else if destination == 32 then 52.0
else if destination == 33 then 57.0
else if destination == 34 then 62.0
else if destination == 35 then 67.0
else if destination == 36 then 72.0
else if destination == 37 then 77.0
else if destination == 38 then 82.0
else if destination == 39 then 87.0
else if destination == 40 then 92.0
else if destination == 41 then 92.0
else if destination == 42 then 7.0
else if destination == 43 then 12.0
else if destination == 44 then 12.0
else if destination == 45 then 17.0
else if destination == 46 then 17.0
else if destination == 47 then 27.0
else if destination == 48 then 32.0
else if destination == 49 then 37.0
else if destination == 50 then 32.0
else if destination == 51 then 37.0
else if destination == 52 then 42.0
else if destination == 53 then 42.0
else if destination == 54 then 37.0
else if destination == 55 then 42.0
else if destination == 56 then 52.0
else if destination == 57 then 57.0
else if destination == 58 then 62.0
else if destination == 59 then 67.0
else if destination == 60 then 72.0
else if destination == 61 then 72.0
else if destination == 62 then 77.0
else if destination == 63 then 77.0
else if destination == 64 then 82.0
else if destination == 65 then 87.0
else if destination == 66 then 92.0
else if destination == 67 then 67.0
else if destination == 68 then 67.0
else if destination == 69 then 72.0
else if destination == 70 then 57.0
else if destination == 71 then 62.0
else if destination == 72 then 67.0
else 0.0


// Calculate relative latency when an item is delivered.
// The backwards-compatible global_latency alias now contains relative latency.
output global_relative_latency eval when delivered with if time - create_item(itemId).hold(or: 0.0) - min_delivery_time < 0.0 then 0.0
    else time - create_item(itemId).hold(or: 0.0) - min_delivery_time

output global_latency eval when delivered with if time - create_item(itemId).hold(or: 0.0) - min_delivery_time < 0.0 then 0.0
    else time - create_item(itemId).hold(or: 0.0) - min_delivery_time

// Emit monitor signals every 10 simulated seconds. The simulator sends
// adaptation_check inputs to advance the offline monitor clock even when no
// create/deliver event occurs exactly at the check time.
output latest_relative_latency eval @0.1Hz with global_relative_latency.hold(or: 0.0)
output latest_latency eval @0.1Hz with global_relative_latency.hold(or: 0.0)

// Calculate mean relative latency over delivered items in the last simulated hour.
output mean_relative_latency_1h eval @0.1Hz with global_relative_latency.aggregate(over: 3600s, using: avg).defaults(to: 0.0)
output mean_latency_1h eval @0.1Hz with global_relative_latency.aggregate(over: 3600s, using: avg).defaults(to: 0.0)

// One-hour evidence windows, sampled at adaptation-check frequency.
output monitor_created_tasks_1h eval @0.1Hz with monitor_created_task_event.aggregate(over: 3600s, using: count)
output monitor_delivered_tasks_1h eval @0.1Hz with monitor_delivered_task_event.aggregate(over: 3600s, using: count)
output monitor_expired_tasks_1h eval @0.1Hz with monitor_expired_task_event.aggregate(over: 3600s, using: count)
output monitor_message_count_1h eval @0.1Hz with monitor_message_event.aggregate(over: 3600s, using: count)
output monitor_message_losses_1h eval @0.1Hz with monitor_message_loss_event.aggregate(over: 3600s, using: count)
output monitor_network_probe_count_1h eval @0.1Hz with monitor_network_probe_event.aggregate(over: 3600s, using: count)
output monitor_network_probe_losses_1h eval @0.1Hz with monitor_network_probe_loss_event.aggregate(over: 3600s, using: count)
output monitor_failures_1h eval @0.1Hz with monitor_failure_event.aggregate(over: 3600s, using: count)
output monitor_rescue_requests_1h eval @0.1Hz with monitor_rescue_request_event.aggregate(over: 3600s, using: count)
output monitor_fake_evidence_1h eval @0.1Hz with monitor_fake_evidence_event.aggregate(over: 3600s, using: count)
output monitor_suspicious_signals_1h eval @0.1Hz with monitor_suspicious_signal_event.aggregate(over: 3600s, using: count)
output monitor_coordinator_outages_1h eval @0.1Hz with monitor_coordinator_outage_event.aggregate(over: 3600s, using: count)
