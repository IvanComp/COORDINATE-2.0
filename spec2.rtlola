// time,itemId,event,destination,minimum_delivery_time
input time: Float
input itemId: Int
input event: String
input destination: Int
input minimum_delivery_time: Float

// Helper streams to simplify event checking
output created: Bool   := event == "create"
output delivered: Bool := event == "deliver"
output expired: Bool   := event == "expire"

// Task-outcome evidence for the completion-constrained performance objective.
// Completion is formed from delivered and expired task outcomes over the same
// rolling horizon; pending tasks are kept as context rather than successes.
output monitor_created_task_event: Float
    eval when created with 1.0
output monitor_delivered_task_event: Float
    eval when delivered with 1.0
output monitor_expired_task_event: Float
    eval when expired with 1.0

// Runtime evidence used by Dynamic Adaptation.  These streams are derived
// exclusively from events observed by the monitor; no simulation parameter is
// exposed to the adaptation policy.
output monitor_message_event: Float
    eval when event == "message_delivered" or event == "message_lost" with 1.0
output monitor_message_loss_event: Float
    eval when event == "message_lost" with 1.0
output monitor_network_probe_event: Float
    eval when event == "network_probe_delivered" or event == "network_probe_lost" with 1.0
output monitor_network_probe_loss_event: Float
    eval when event == "network_probe_lost" with 1.0
output monitor_failure_event: Float
    eval when event == "agent_failed" with 1.0
output monitor_rescue_request_event: Float
    eval when event == "rescue_request" with 1.0
output monitor_fake_evidence_event: Float
    eval when event == "verified_fake_request" with 1.0
output monitor_suspicious_signal_event: Float
    eval when event == "suspicious_signal" with 1.0
output monitor_coordinator_outage_event: Float
    eval when event == "coordinator_unavailable" with 1.0

output create_item(id): Float
    spawn when created with itemId
    eval when id = itemId and created with time
    close when id = itemId and (delivered or expired)

output deliver_item(id): Float
    spawn when delivered with itemId
    eval when id = itemId and delivered with time
    close when id = itemId and delivered

output latency(id): Float
    spawn when created with itemId
    eval when id = itemId and delivered with time - create_item(id).hold(or: 0.0)
    close when id = itemId and (delivered or expired)

output min_delivery_time: Float := minimum_delivery_time

// Calculate relative latency when an item is delivered.
// The backwards-compatible global_latency alias now contains relative latency.
output global_relative_latency eval when delivered with if time - create_item(itemId).hold(or: 0.0) - min_delivery_time < 0.0 then 0.0
    else time - create_item(itemId).hold(or: 0.0) - min_delivery_time

output global_latency eval when delivered with if time - create_item(itemId).hold(or: 0.0) - min_delivery_time < 0.0 then 0.0
    else time - create_item(itemId).hold(or: 0.0) - min_delivery_time

// Emit monitor signals every 10 simulated seconds. The simulator sends
// adaptation_check inputs to advance the offline monitor clock even when no
// create/deliver event occurs exactly at the check time.
output latest_relative_latency eval @0.1Hz with global_relative_latency.hold(or: 0.0)
output latest_latency eval @0.1Hz with global_relative_latency.hold(or: 0.0)

// Window durations marked below are configured by the simulator. Stream names are retained for compatibility.
output mean_relative_latency_1h eval @0.1Hz with global_relative_latency.aggregate(over: 3600s, using: avg).defaults(to: 0.0) // coordinate-adaptation-window
output mean_latency_1h eval @0.1Hz with global_relative_latency.aggregate(over: 3600s, using: avg).defaults(to: 0.0) // coordinate-adaptation-window

// Evidence windows sampled every 10 simulated seconds.
output monitor_created_tasks_1h eval @0.1Hz with monitor_created_task_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_delivered_tasks_1h eval @0.1Hz with monitor_delivered_task_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_expired_tasks_1h eval @0.1Hz with monitor_expired_task_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_message_count_1h eval @0.1Hz with monitor_message_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_message_losses_1h eval @0.1Hz with monitor_message_loss_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_network_probe_count_1h eval @0.1Hz with monitor_network_probe_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_network_probe_losses_1h eval @0.1Hz with monitor_network_probe_loss_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_failures_1h eval @0.1Hz with monitor_failure_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_rescue_requests_1h eval @0.1Hz with monitor_rescue_request_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_fake_evidence_1h eval @0.1Hz with monitor_fake_evidence_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_suspicious_signals_1h eval @0.1Hz with monitor_suspicious_signal_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window
output monitor_coordinator_outages_1h eval @0.1Hz with monitor_coordinator_outage_event.aggregate(over: 3600s, using: count) // coordinate-adaptation-window

output service_relative_latency eval @0.1Hz with global_relative_latency.aggregate(over: 1800s, using: avg).defaults(to: 0.0) // coordinate-service-window
output service_delivered_tasks eval @0.1Hz with monitor_delivered_task_event.aggregate(over: 1800s, using: count) // coordinate-service-window
output service_expired_tasks eval @0.1Hz with monitor_expired_task_event.aggregate(over: 1800s, using: count) // coordinate-service-window
